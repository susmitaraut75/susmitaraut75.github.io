---
const highlights = [
  { icon: '💼', label: 'Years Experience', value: '2+' },
  { icon: '🎓', label: 'Cert III Qualified', value: 'CHC33021' },
  { icon: '🏥', label: 'Healthcare Background', value: 'Nursing' },
  { icon: '🇦🇺', label: 'Work Rights', value: 'Full' },
];
---

<section id="about" class="section about-section">
  <div class="about-bg-accent"></div>
  <div class="container">
    <div class="section-header animate-on-scroll">
      <h2 class="section-title">About Me</h2>
      <p class="section-subtitle">Dedicated to providing compassionate, person-centred care</p>
    </div>

    <div class="about-content animate-on-scroll animate-delay-1">
      <div class="about-text glass-card">
        <p>
          Compassionate and reliable Personal Care Assistant with Australian aged care experience
          and an overseas nursing background. Experienced in maintaining high standards of
          infection control, resident safety, personal support, and respectful communication.
        </p>
        <p>
          Certificate III in Individual Support qualified and committed to delivering
          person-centred care that promotes dignity, independence, and wellbeing.
        </p>
        <p class="about-availability">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          Available for morning, afternoon, night, weekend, and public holiday shifts
        </p>
        <div class="about-cta">
          <a href="/resume.pdf" download="Susmita_Raut_Resume.pdf" class="btn btn-primary" target="_blank">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Download Resume (PDF)
          </a>
        </div>
      </div>
    </div>

    <div class="highlights-grid">
      {highlights.map((item, index) => (
        <div class={`highlight-card animate-on-scroll animate-delay-${index + 1}`}>
          <span class="highlight-icon">{item.icon}</span>
          <span class="highlight-value">{item.value}</span>
          <span class="highlight-label">{item.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .about-section {
    position: relative;
    overflow: hidden;
  }

  .about-bg-accent {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 50%;
    background: linear-gradient(180deg, var(--color-bg-alt), var(--color-bg));
    z-index: 0;
  }

  .about-section .container {
    position: relative;
    z-index: 1;
  }

  .about-content {
    max-width: 800px;
    margin: 0 auto var(--space-3xl);
  }

  .about-text p {
    margin-bottom: var(--space-lg);
    color: var(--color-text-light);
    font-size: var(--fs-md);
    line-height: 1.8;
  }

  .about-text p:last-of-type {
    margin-bottom: 0;
  }

  .about-availability {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border);
    color: var(--color-primary) !important;
    font-weight: 500;
    font-size: var(--fs-sm) !important;
  }

  .about-availability svg {
    flex-shrink: 0;
    color: var(--color-primary);
  }

  .about-cta {
    margin-top: var(--space-lg);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border);
    display: flex;
    justify-content: center;
  }

  /* Highlights Grid */
  .highlights-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-lg);
  }

  .highlight-card {
    text-align: center;
    padding: var(--space-2xl) var(--space-lg);
    background: var(--color-white);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    transition: all var(--transition-base);
    cursor: default;
  }

  .highlight-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-primary-light);
  }

  .highlight-icon {
    font-size: 2rem;
    display: block;
    margin-bottom: var(--space-md);
  }

  .highlight-value {
    display: block;
    font-family: var(--font-heading);
    font-size: var(--fs-xl);
    font-weight: 700;
    color: var(--color-primary-dark);
    margin-bottom: var(--space-xs);
  }

  .highlight-label {
    font-size: var(--fs-xs);
    color: var(--color-text-lighter);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .highlights-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .highlights-grid {
      grid-template-columns: 1fr;
    }

    .highlight-card {
      padding: var(--space-lg);
    }

    .about-availability {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
