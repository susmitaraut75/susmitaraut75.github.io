---
const currentYear = new Date().getFullYear();

const quickLinks = [
  { label: 'About', href: '#about' },
  { label: 'Experience', href: '#experience' },
  { label: 'Education', href: '#education' },
  { label: 'Skills', href: '#skills' },
  { label: 'Contact', href: '#contact' },
];
---

<footer class="footer">
  <div class="container">
    <div class="footer-content">
      <div class="footer-brand">
        <a href="#hero" class="footer-logo">
          <span class="footer-logo-text">S</span>
          <span class="footer-logo-name">Susmita Raut</span>
        </a>
        <p class="footer-tagline">Compassionate Care, Professional Excellence</p>
      </div>

      <div class="footer-links">
        <h4>Quick Links</h4>
        <ul>
          {quickLinks.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-contact">
        <h4>Contact</h4>
        <p>
          <a href="mailto:rautsushmeeta@gmail.com">rautsushmeeta@gmail.com</a>
        </p>
        <p>Melbourne, VIC, Australia</p>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {currentYear} Susmita Raut. All rights reserved.</p>
      <a href="#hero" class="back-to-top" aria-label="Back to top">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="19" x2="12" y2="5"></line>
          <polyline points="5 12 12 5 19 12"></polyline>
        </svg>
      </a>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-text);
    color: rgba(255, 255, 255, 0.7);
    padding: var(--space-3xl) 0 var(--space-xl);
  }

  .footer-content {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: var(--space-3xl);
    margin-bottom: var(--space-3xl);
    padding-bottom: var(--space-2xl);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  /* Brand */
  .footer-logo {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    text-decoration: none;
    margin-bottom: var(--space-md);
  }

  .footer-logo-text {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
    color: var(--color-white);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-size: var(--fs-md);
    font-weight: 600;
  }

  .footer-logo-name {
    font-family: var(--font-heading);
    font-size: var(--fs-md);
    font-weight: 600;
    color: var(--color-white);
  }

  .footer-tagline {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: var(--fs-sm);
    color: rgba(255, 255, 255, 0.5);
  }

  /* Links */
  .footer-links h4,
  .footer-contact h4 {
    font-family: var(--font-heading);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-white);
    margin-bottom: var(--space-lg);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .footer-links ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .footer-links a,
  .footer-contact a {
    color: rgba(255, 255, 255, 0.6);
    font-size: var(--fs-sm);
    transition: color var(--transition-fast);
  }

  .footer-links a:hover,
  .footer-contact a:hover {
    color: var(--color-primary-light);
  }

  .footer-contact p {
    font-size: var(--fs-sm);
    margin-bottom: var(--space-sm);
  }

  /* Bottom */
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-bottom p {
    font-size: var(--fs-xs);
    color: rgba(255, 255, 255, 0.4);
  }

  .back-to-top {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.5);
    transition: all var(--transition-fast);
  }

  .back-to-top:hover {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-white);
    transform: translateY(-2px);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .footer-content {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
    }
  }

  @media (max-width: 480px) {
    .footer-bottom {
      flex-direction: column;
      gap: var(--space-md);
      text-align: center;
    }
  }
</style>
