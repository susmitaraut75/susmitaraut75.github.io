---
const education = {
  degree: 'Diploma of Nursing',
  institution: 'Himalayan Medical Education Society',
  location: 'Nepal',
  year: '2022',
};

const certifications = [
  { name: 'Certificate III in Individual Support', code: 'CHC33021', highlight: true },
  { name: 'First Aid & CPR Certificate', code: '', highlight: false },
  { name: 'Manual Handling', code: '', highlight: false },
  { name: 'Food Handling Certificate', code: 'HLTFSE001', highlight: false },
  { name: 'National Police Check', code: '', highlight: false },
  { name: 'Working with Children Check', code: '', highlight: false },
  { name: 'COVID-19 Vaccinated', code: '', highlight: false },
  { name: 'Up-to-date Immunisations', code: '', highlight: false },
];
---

<section id="education" class="section education-section">
  <div class="container">
    <div class="section-header animate-on-scroll">
      <h2 class="section-title">Education & Certifications</h2>
      <p class="section-subtitle">Qualified and committed to continuous professional development</p>
    </div>

    <div class="education-grid">
      <!-- Education Card -->
      <div class="edu-card glass-card animate-on-scroll animate-delay-1">
        <div class="edu-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
            <path d="M6 12v5c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2v-5"></path>
          </svg>
        </div>
        <h3 class="edu-degree">{education.degree}</h3>
        <p class="edu-institution">{education.institution}</p>
        <div class="edu-meta">
          <span class="edu-location">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            {education.location}
          </span>
          <span class="edu-year">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            {education.year}
          </span>
        </div>
      </div>

      <!-- Certifications Card -->
      <div class="certs-card glass-card animate-on-scroll animate-delay-2">
        <h3 class="certs-title">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
          </svg>
          Certifications & Checks
        </h3>
        <div class="certs-grid">
          {certifications.map((cert) => (
            <div class={`cert-badge ${cert.highlight ? 'cert-highlight' : ''}`}>
              <span class="cert-check">✓</span>
              <div class="cert-info">
                <span class="cert-name">{cert.name}</span>
                {cert.code && <span class="cert-code">{cert.code}</span>}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .education-grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: var(--space-2xl);
    align-items: start;
  }

  /* Education Card */
  .edu-card {
    text-align: center;
    padding: var(--space-3xl) var(--space-2xl);
  }

  .edu-icon {
    width: 70px;
    height: 70px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary-lighter), var(--color-primary-light));
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto var(--space-xl);
    color: var(--color-primary-dark);
  }

  .edu-degree {
    font-family: var(--font-heading);
    font-size: var(--fs-xl);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--space-sm);
  }

  .edu-institution {
    font-size: var(--fs-md);
    color: var(--color-text-light);
    margin-bottom: var(--space-lg);
  }

  .edu-meta {
    display: flex;
    justify-content: center;
    gap: var(--space-xl);
    flex-wrap: wrap;
  }

  .edu-location,
  .edu-year {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--fs-sm);
    color: var(--color-text-lighter);
  }

  .edu-location svg,
  .edu-year svg {
    color: var(--color-primary);
  }

  /* Certifications */
  .certs-title {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-heading);
    font-size: var(--fs-lg);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--space-xl);
  }

  .certs-title svg {
    color: var(--color-primary);
  }

  .certs-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .cert-badge {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-md) var(--space-lg);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    transition: all var(--transition-fast);
  }

  .cert-badge:hover {
    border-color: var(--color-primary-light);
    transform: translateX(4px);
  }

  .cert-highlight {
    background: linear-gradient(135deg, rgba(194, 118, 128, 0.08), rgba(194, 118, 128, 0.03));
    border-color: var(--color-primary-light);
  }

  .cert-check {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
    color: var(--color-white);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--fs-xs);
    font-weight: 700;
    flex-shrink: 0;
  }

  .cert-info {
    display: flex;
    flex-direction: column;
  }

  .cert-name {
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--color-text);
  }

  .cert-code {
    font-size: var(--fs-xs);
    color: var(--color-text-lighter);
    font-family: monospace;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .education-grid {
      grid-template-columns: 1fr;
    }

    .edu-card {
      padding: var(--space-2xl);
    }
  }

  @media (max-width: 480px) {
    .cert-badge {
      padding: var(--space-sm) var(--space-md);
    }

    .edu-meta {
      flex-direction: column;
      align-items: center;
      gap: var(--space-sm);
    }
  }
</style>
