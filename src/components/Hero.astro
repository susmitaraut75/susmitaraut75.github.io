---

---

<section id="hero" class="hero">
  <!-- Decorative background elements -->
  <div class="hero-bg">
    <div class="bg-gradient"></div>
    <div class="bg-circle bg-circle-1"></div>
    <div class="bg-circle bg-circle-2"></div>
    <div class="bg-circle bg-circle-3"></div>
  </div>

  <div class="container hero-content">
    <div class="hero-text">
      <p class="hero-greeting">Hello, I'm</p>
      <h1 class="hero-name">Susmita Raut</h1>
      <p class="hero-title">Personal Care Assistant & Aged Care Support Worker</p>
      <p class="hero-tagline">Compassionate Care, Professional Excellence</p>
      <p class="hero-location">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        Melbourne, VIC, Australia
      </p>
      <div class="hero-cta">
        <a href="#experience" class="btn btn-primary">
          View My Experience
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <a href="#contact" class="btn btn-outline">Contact Me</a>
        <a href="/resume.pdf" download="Susmita_Raut_Resume.pdf" class="btn btn-outline" target="_blank">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          Resume
        </a>
      </div>
    </div>

    <div class="hero-image-wrapper">
      <div class="hero-image-container">
        <div class="image-ring"></div>
        <img
          src="/images/susmita.jpeg"
          alt="Susmita Raut — Personal Care Assistant"
          class="hero-image"
          loading="eager"
        />
      </div>
      <div class="hero-badge badge-cert">
        <span class="badge-icon">🎓</span>
        <span class="badge-text">Cert III Qualified</span>
      </div>
      <div class="hero-badge badge-work">
        <span class="badge-icon">🇦🇺</span>
        <span class="badge-text">Full Work Rights</span>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="scroll-indicator">
    <div class="scroll-mouse">
      <div class="scroll-dot"></div>
    </div>
    <span>Scroll Down</span>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    padding-top: var(--nav-height);
  }

  /* Background decorations */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .bg-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      var(--color-bg) 0%,
      var(--color-primary-lighter) 30%,
      var(--color-bg) 60%,
      var(--color-accent-light) 100%
    );
    background-size: 200% 200%;
    animation: gradient-shift 8s ease infinite;
  }

  .bg-circle {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    opacity: 0.4;
  }

  .bg-circle-1 {
    width: 400px;
    height: 400px;
    background: var(--color-primary-light);
    top: -100px;
    right: -100px;
    animation: float 6s ease-in-out infinite;
  }

  .bg-circle-2 {
    width: 300px;
    height: 300px;
    background: var(--color-accent-light);
    bottom: -50px;
    left: -50px;
    animation: float 8s ease-in-out infinite reverse;
  }

  .bg-circle-3 {
    width: 200px;
    height: 200px;
    background: var(--color-primary-lighter);
    top: 50%;
    left: 50%;
    animation: float 7s ease-in-out infinite;
  }

  /* Content layout */
  .hero-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3xl);
    position: relative;
    z-index: 1;
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-2xl);
  }

  /* Text section */
  .hero-text {
    flex: 1;
    max-width: 560px;
    animation: fadeInUp 0.8s ease-out;
  }

  .hero-greeting {
    font-size: var(--fs-md);
    color: var(--color-primary);
    font-weight: 500;
    margin-bottom: var(--space-sm);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .hero-name {
    font-family: var(--font-heading);
    font-size: var(--fs-hero);
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.1;
    margin-bottom: var(--space-md);
  }

  .hero-title {
    font-size: var(--fs-lg);
    color: var(--color-text-light);
    font-weight: 400;
    margin-bottom: var(--space-sm);
  }

  .hero-tagline {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: var(--fs-md);
    color: var(--color-primary);
    margin-bottom: var(--space-lg);
  }

  .hero-location {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: var(--fs-sm);
    color: var(--color-text-lighter);
    margin-bottom: var(--space-2xl);
  }

  .hero-location svg {
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .hero-cta {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  /* Image section */
  .hero-image-wrapper {
    position: relative;
    flex-shrink: 0;
    animation: scaleIn 0.8s ease-out 0.2s both;
  }

  .hero-image-container {
    position: relative;
    width: 340px;
    height: 340px;
  }

  .image-ring {
    position: absolute;
    inset: -12px;
    border-radius: 50%;
    border: 2px solid var(--color-primary-light);
    animation: pulse-glow 3s ease-in-out infinite;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    border: 4px solid var(--color-white);
    box-shadow: var(--shadow-lg);
  }

  /* Floating badges */
  .hero-badge {
    position: absolute;
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    background: var(--color-white);
    padding: 10px 18px;
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-md);
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--color-text);
    white-space: nowrap;
    animation: fadeIn 0.8s ease-out 0.6s both;
  }

  .badge-icon {
    font-size: 1.1rem;
  }

  .badge-cert {
    top: 30px;
    right: -20px;
    animation: float 5s ease-in-out infinite;
  }

  .badge-work {
    bottom: 30px;
    left: -30px;
    animation: float 6s ease-in-out infinite reverse;
  }

  /* Scroll indicator */
  .scroll-indicator {
    position: absolute;
    bottom: var(--space-2xl);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    animation: fadeIn 1s ease-out 1s both;
    z-index: 1;
  }

  .scroll-indicator span {
    font-size: var(--fs-xs);
    color: var(--color-text-lighter);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .scroll-mouse {
    width: 24px;
    height: 38px;
    border: 2px solid var(--color-primary-light);
    border-radius: 12px;
    position: relative;
  }

  .scroll-dot {
    width: 4px;
    height: 8px;
    background: var(--color-primary);
    border-radius: var(--radius-full);
    position: absolute;
    top: 6px;
    left: 50%;
    transform: translateX(-50%);
    animation: scrollBounce 1.5s ease-in-out infinite;
  }

  @keyframes scrollBounce {
    0%, 100% { top: 6px; opacity: 1; }
    50% { top: 18px; opacity: 0.3; }
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .hero-content {
      gap: var(--space-2xl);
    }

    .hero-image-container {
      width: 280px;
      height: 280px;
    }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      padding-top: calc(var(--nav-height) + var(--space-2xl));
      padding-bottom: var(--space-4xl);
    }

    .hero-content {
      flex-direction: column-reverse;
      text-align: center;
    }

    .hero-text {
      max-width: 100%;
    }

    .hero-location {
      justify-content: center;
    }

    .hero-cta {
      justify-content: center;
    }

    .hero-image-container {
      width: 300px;
      height: 300px;
    }

    .badge-cert {
      right: -10px;
      top: 150px;
    }

    .badge-work {
      left: -10px;
      bottom: -10px;
    }

    .scroll-indicator {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .hero-image-container {
      width: 300px;
      height: 300px;
    }

    .hero-cta {
      flex-direction: column;
      align-items: center;
    }

    .badge-cert {
      right: -15px;
      top: 120px;
    }

    .badge-work {
      left: -15px;
      bottom: -15px;
    }

    .hero-badge {
      padding: 8px 14px;
      font-size: 0.7rem;
    }
  }
</style>
